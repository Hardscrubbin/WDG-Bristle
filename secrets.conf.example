# =============================================================================
# Watch Dogs Go — secrets.conf template
# =============================================================================
# Copy this file to secrets.conf and fill in your API keys.
# All keys are OPTIONAL — the game runs without them, just with reduced features.
#
#   cp secrets.conf.example secrets.conf
#   nano secrets.conf
#
# secrets.conf is gitignored — never commit it to git.
# =============================================================================


# -----------------------------------------------------------------------------
# WPA-sec — distributed WPA handshake cracker
# -----------------------------------------------------------------------------
# Sign up at: https://wpa-sec.stanev.org/
# Used by: SYSTEM > Upload to WPA-sec / Download cracked passwords
#
# WDG_WPASEC_KEY=your-wpa-sec-key-here
# (legacy name JANOS_WPASEC_KEY is also accepted for backwards compatibility)


# -----------------------------------------------------------------------------
# Wigle — global WiFi mapping (wigle.net)
# -----------------------------------------------------------------------------
# Sign up at: https://wigle.net/
# Used by: optional wardriving CSV upload
#
# WDG_WIGLE_NAME=your-username
# WDG_WIGLE_TOKEN=your-api-token


# -----------------------------------------------------------------------------
# WDGoWars — community wardriving server (wdgwars.pl)
# -----------------------------------------------------------------------------
# Register at: https://wdgwars.pl
# After registration you'll get a 64-character hex API key.
# Used by: PLUGINS > Watch Dogs Go Wars Sync
#
# Server URL is built into the plugin — you only need the key.
# Override URL only if running your own server.
#
# WARDRIVE_API_KEY=your-64-char-hex-key
# WARDRIVE_API_URL=https://your-own-server.example/api/upload/


# -----------------------------------------------------------------------------
# Stadia Maps — offline map tile downloads (SYSTEM > Download Map)
# -----------------------------------------------------------------------------
# Free account at https://stadiamaps.com gives an API key with a generous
# quota for personal use. The game downloads "Alidade Smooth Dark" tiles
# (a clean dark style that fits the cyberpunk overlay) into maps/ and
# renders them under the radar/markers.
#
# Without this key the Download Map menu entry will tell you to add it.
#
# STADIA_API_KEY=your-stadia-key-here
#
# [merge-v3] MapTiler works instead of (or as well as) Stadia, for both
# SYSTEM > Download Map and SYSTEM > Auto Map + Turf. Free key at
# https://www.maptiler.com ("Dataviz Dark" style). With only a MapTiler key
# set, MapTiler is used. With both set, Stadia is used unless you force it.
# (Written as "e.g." so a copied template doesn't trigger the
#  "commented key is ignored" startup warning.)
#   e.g.  MAPTILER_API_KEY=your-maptiler-key-here
#   e.g.  TILE_PROVIDER=maptiler
#
# Tiles from both providers share the maps/ cache. Switching provider does
# not re-download tiles you already have.


# -----------------------------------------------------------------------------
# [merge-v3] Plugins you never use
# -----------------------------------------------------------------------------
# Comma-separated plugin file names (without .py) that should not be loaded
# at all: not in the PLUGINS menu, never ticked.
#   e.g.  DISABLED_PLUGINS=janos_import


# -----------------------------------------------------------------------------
# [v2] Kismet Wardrive Bridge + system health (all optional)
# -----------------------------------------------------------------------------
# (Written as "e.g." so a copied template doesn't trigger the
#  "commented key is ignored" startup warning. Add the bare KEY=value
#  line without '#' to use one.)
#
# Kismet reads GPS from the same gpsd the game uses (geotags the .kismet
# file). Set to 0 if your kismet_site.conf already has its own gps= line.
#   e.g.  WDG_KISMET_GPSD=0
#
# Auto-rotation (both off by default). Rotation restarts Kismet on the
# same adapters; the drive's stats and GPS-held records carry over.
#   minutes per Kismet segment:                 e.g.  WDG_KISMET_ROTATE_MIN=60
#   restart when Kismet's RAM reaches N MB:     e.g.  WDG_KISMET_ROTATE_MB=1500
#
# Optional read-only Kismet API key (Kismet web UI > Settings > API Keys):
#   e.g.  WDG_KISMET_API_KEY=your-readonly-key
#
# SoC temperature thresholds for the HUD colour + terminal alerts
# (defaults 70 / 80; CM5 / Pi 5 firmware starts throttling at 80C):
#   e.g.  WDG_TEMP_WARN_C=70
#   e.g.  WDG_TEMP_HOT_C=80


# -----------------------------------------------------------------------------
# [merge-v3] Two Wi-Fi adapters, two GPS receivers (all optional)
# -----------------------------------------------------------------------------
# With two Wi-Fi adapters capturing at once (e.g. the Alfa and an AC1200) the
# Kismet bridge gives the 2.4 GHz channels to one and the 5 / 6 GHz channels to
# the other. "off" lets every adapter hop every channel, as Kismet does alone.
# (S in the adapter picker changes it for one run.) The split needs Kismet's
# own login: with a read-only WDG_KISMET_API_KEY Kismet refuses it and both
# adapters simply keep hopping everything.
#   e.g.  WDG_KISMET_SPLIT=off
#
# With two GPS receivers behind gpsd, Kismet reads only the one the game is
# following, through a small local filter (port 2948). 0 = point Kismet
# straight at gpsd even then.
#   e.g.  WDG_KISMET_GPS_PROXY=0
#
# Not secrets.conf keys but environment variables, for odd setups:
#   WDG_GPS_ANTENNA_WATCH=0   do not open the extra gpsd connections that read
#                             the receivers' own antenna status (NMEA TXT)
#   WDG_BASEMAP_DIM=0.6       brightness of the offline world basemap (0.2 - 1.0)

# --- Bristle Nodes ---------------------------------------------------------
# The owner key your nodes answer to. Leave this out: the game makes one the
# first time Bristle starts and adds the line itself. 32 hex digits. Never
# share it. Back it up with this file (loot backups include secrets.conf).
# BRISTLE_OWNER_KEY=00000000000000000000000000000000
# Shown in SYSTEM > Update Game as "New builds: ..." if you set it (never fetched):
# WDG_UPDATE_PAGE=
